# Renomeie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# Token secreto da sua integração interna do Notion (gerado em notion.so/my-integrations)
NOTION_TOKEN=seu_token_aqui

# ID do database do Notion onde os relatórios serão inseridos
NOTION_DATABASE_ID=seu_database_id_aqui
